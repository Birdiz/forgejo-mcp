# --- Target instance (required, both transports) ---
# Fixed server-side: callers never choose the host (SSRF guard).
FORGEJO_URL="https://forgejo.example.org"

# --- stdio mode (local) ---
# Personal Forgejo token. Scopes: write:issue, write:repository.
# Create one at <FORGEJO_URL>/user/settings/applications
# NEVER set this in http mode: there the token comes from the Authorization header.
FORGEJO_TOKEN=""

# --- Default repository (optional) ---
# Saves repeating owner/repo on every tool call.
FORGEJO_DEFAULT_OWNER=""
FORGEJO_DEFAULT_REPO=""

# --- http mode (Railway) ---
# TRANSPORT=http enables the HTTP server. Keep PORT aligned with the domain's target port.
TRANSPORT="stdio"
PORT="3000"
