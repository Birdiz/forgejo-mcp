# --- Instance ciblée (obligatoire, les deux modes) ---
# Fixée côté serveur : l'appelant ne choisit jamais l'hôte (anti-SSRF).
FORGEJO_URL="https://forgejo.example.org"

# --- Mode stdio (local) ---
# Token personnel Forgejo. Scopes : write:issue, write:repository.
# À créer sur <FORGEJO_URL>/user/settings/applications
# JAMAIS en mode http : en HTTP le token vient de l'en-tête Authorization.
FORGEJO_TOKEN=""

# --- Dépôt par défaut (facultatif) ---
# Évite de répéter owner/repo à chaque appel d'outil.
FORGEJO_DEFAULT_OWNER=""
FORGEJO_DEFAULT_REPO=""

# --- Mode http (Railway) ---
# TRANSPORT=http active le serveur HTTP. PORT est fourni par Railway.
TRANSPORT="stdio"
PORT="3000"
